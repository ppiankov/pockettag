<?xml version="1.0" encoding="utf-8"?>
<!-- WO-15: large sharing cues remain reachable with large fonts and long item labels. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/booth_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/booth_instruction"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/booth_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textSize="20sp" />

        <Button
            android:id="@+id/booth_nfc_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/booth_nfc_settings"
            android:visibility="gone" />

        <TextView
            android:id="@+id/booth_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/booth_sent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/booth_sent"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>
</ScrollView>
