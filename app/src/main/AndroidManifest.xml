<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deliberately no INTERNET permission: the app never touches the network. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- WO-22: only Open SOS requests optional notification visibility on Android 13 and newer. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.nfc.hce" android:required="true" />

    <!-- WO-2: reconciliation runs even when Android restores a screen other than the selector. -->
    <application
        android:name=".PocketTagApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- WO-2: the vendor library is optional; other phones continue to use HCE. -->
        <uses-library android:name="com.nxp.nfc" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WO-21: sharing text reaches a draft receiver while the editor remains private. -->
        <!-- WO-21: finishing during onCreate avoids showing a blank receiver screen. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- WO-3: manual item editing is reachable only from the app's selector. -->
        <activity
            android:name=".EditItemActivity"
            android:exported="false" />

        <!-- WO-15: booth mode is an internal, full-screen sharing surface. -->
        <activity
            android:name=".BoothActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen" />

        <!-- WO-28: only setup and an explicit Open notification token may open the beacon. -->
        <activity
            android:name=".SosBeaconActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen" />

        <!-- WO-22: Android alone may bind the SOS tile; it is not another requested app permission. -->
        <service
            android:name=".SosTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@android:drawable/sym_def_app_icon"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <!-- WO-22: Off is reachable only through the notification's explicit immutable action. -->
        <receiver android:name=".SosOffReceiver" android:exported="false" />

        <service
            android:name=".NdefHostApduService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>
    </application>
</manifest>
